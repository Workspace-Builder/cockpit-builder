{
  "name": "cockpit-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3970",
    "build": "next build",
    "start": "next start --port 3970",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:psql": "docker exec -it cockpit-postgres psql -U cockpit -d cockpit",
    "db:importar": "node scripts/importar-legado.mjs",
    "db:reset": "node scripts/migrate.mjs && node scripts/importar-legado.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "^16.2.7",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
